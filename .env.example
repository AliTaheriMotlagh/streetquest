# Postgres. On Vercel these are set automatically by the Neon integration
# (DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct for schema changes).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streetquest"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/streetquest"
# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET="change-me"
# Opening /admin?key=<this> makes the current player an admin (there is no login)
ADMIN_KEY="change-me-too"
# Your public URL (used for canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional: map tile provider for production traffic
# NEXT_PUBLIC_TILE_URL="https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_KEY"
# NEXT_PUBLIC_TILE_ATTRIBUTION="&copy; MapTiler &copy; OpenStreetMap contributors"
