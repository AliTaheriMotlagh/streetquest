# Postgres. On Vercel these are set automatically by the Neon integration
# (DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct for schema changes).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streetquest"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/streetquest"
# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET="change-me"
# Opening /admin?key=<this> makes the current player an admin (there is no login)
ADMIN_KEY="change-me-too"
# Test mode (tap-to-move, no GPS) is open to everyone by default; "off" limits it to admins
# TEST_MODE="off"
# Your public URL (used for canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Street Arena realtime server (npm run rt). Empty = no live multiplayer in the 3D city.
NEXT_PUBLIC_RT_URL="ws://localhost:8787"
# Optional: map tile provider for production traffic
# NEXT_PUBLIC_TILE_URL="https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_KEY"
# NEXT_PUBLIC_TILE_ATTRIBUTION="&copy; MapTiler &copy; OpenStreetMap contributors"

# Vercel Cron secret for /api/cron/cleanup (daily housekeeping). Vercel sends it automatically
# when set in Project → Settings → Environment Variables.
CRON_SECRET=""
# Optional: max DB connections per serverless instance (default 1 on Vercel). Raise only if your
# database URL goes through a pooler.
# DB_CONNECTION_LIMIT=1

# Optional: sell gem packs with Stripe Checkout (Admin → Revenue shows setup steps).
# STRIPE_SECRET_KEY="sk_live_..."
# Webhook for /api/store/webhook (event: checkout.session.completed) — credits gems even if the player closes the tab.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Real ads: Google AdSense → H5 Games Ads (rewarded videos for the "Free gems" button).
# Your publisher id from AdSense → Account → Account information. /ads.txt is served from it.
# Where Google has no ad (some countries, ad blockers), players get the sponsor spot instead.
# ADSENSE_CLIENT="ca-pub-0000000000000000"
# Google's test ads (always fill, never pay). Remove in production.
# ADSENSE_TEST="on"

# Push notifications (Web Push). Generate once with: npx web-push generate-vapid-keys
# Without these the game works, just without phone notifications.
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:you@yourdomain.com"

# TURN relay for crew video calls. Without one, calls only connect when both phones are
# on the same network (same Wi-Fi); between mobile data / different networks they ring,
# then freeze on "Connecting…". Pick ONE:
# 1) Cloudflare Realtime TURN (free tier): dash.cloudflare.com → Realtime → TURN → create a key.
# CLOUDFLARE_TURN_KEY_ID="..."
# CLOUDFLARE_TURN_API_TOKEN="..."
# 2) Metered (free tier): dashboard → TURN Server → API key; the app is the "<app>" in <app>.metered.live.
# METERED_TURN_APP="..."
# METERED_TURN_API_KEY="..."
# 3) Any TURN server with fixed credentials (e.g. your own coturn). Include a turns:…:443 URL:
#    networks that block UDP can still relay over TLS on port 443.
# TURN_URLS="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp"
# TURN_USERNAME="..."
# TURN_CREDENTIAL="..."

# Real places & the 3D city: OpenStreetMap Overpass endpoints, tried in order (comma-separated).
# Defaults to the public servers; at scale run your own. "off" disables fetching (tiles can be uploaded by admins).
# OVERPASS_URL="https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter"
