# Postgres. On Vercel these are set automatically by the Neon integration
# (DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct for schema changes).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streetquest"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/streetquest"
# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET="change-me"
# Opening /admin?key=<this> makes the current player an admin (there is no login)
ADMIN_KEY="change-me-too"
# Test mode (tap-to-move, no GPS) is open to everyone by default; "off" limits it to admins
# TEST_MODE="off"
# Your public URL (used for canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Street Arena realtime server (npm run rt): 20 Hz multiplayer over WebSockets. Optional —
# without it, matches run in the host player's browser and the others join through the game
# server (/api/arena, a few updates a second). Such a match pays XP and coins once it has run
# this long (seconds):
# ARENA_PAID_MIN_S=60
# Optional: map tile provider for production traffic
# NEXT_PUBLIC_TILE_URL="https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_KEY"
# NEXT_PUBLIC_TILE_ATTRIBUTION="&copy; MapTiler &copy; OpenStreetMap contributors"
# 3D city: a colour lookup table (.cube, up to 64³) laid over the finished picture on High/Ultra/Medium.
# NEXT_PUBLIC_DRIVE_LUT="/luts/city.cube"

# Vercel Cron secret for /api/cron/cleanup (daily housekeeping). Vercel sends it automatically
# when set in Project → Settings → Environment Variables.
CRON_SECRET=""
# Optional: max DB connections per serverless instance (default 1 on Vercel). Raise only if your
# database URL goes through a pooler.
# DB_CONNECTION_LIMIT=1

# Optional: sell gem packs with Stripe Checkout (Admin → Revenue shows setup steps).
# STRIPE_SECRET_KEY="sk_live_..."
# Webhook for /api/store/webhook (event: checkout.session.completed) — credits gems even if the player closes the tab.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Real ads: Google AdSense → H5 Games Ads (rewarded videos for the "Free gems" button).
# Your publisher id from AdSense → Account → Account information. /ads.txt is served from it.
# Where Google has no ad (some countries, ad blockers), players get the sponsor spot instead.
# ADSENSE_CLIENT="ca-pub-0000000000000000"
# Google's test ads (always fill, never pay). Remove in production.
# ADSENSE_TEST="on"

# Push notifications (Web Push). Generate once with: npx web-push generate-vapid-keys
# Without these the game works, just without phone notifications.
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:you@yourdomain.com"

# TURN relay for crew video calls. Without one, calls only connect when both phones are
# on the same network (same Wi-Fi); between mobile data / different networks they ring,
# then freeze on "Connecting…". Pick ONE:
# 1) Cloudflare Realtime TURN (free tier): dash.cloudflare.com → Realtime → TURN → create a key.
# CLOUDFLARE_TURN_KEY_ID="..."
# CLOUDFLARE_TURN_API_TOKEN="..."
# 2) Metered (free tier): dashboard → TURN Server → API key; the app is the "<app>" in <app>.metered.live.
# METERED_TURN_APP="..."
# METERED_TURN_API_KEY="..."
# 3) Any TURN server with fixed credentials (e.g. your own coturn). Include a turns:…:443 URL:
#    networks that block UDP can still relay over TLS on port 443.
# TURN_URLS="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp"
# TURN_USERNAME="..."
# TURN_CREDENTIAL="..."

# Live traffic in Iranian cities from Neshan (platform.neshan.org). The key needs the
# "Direction" (مسیریابی) service enabled; without it traffic comes from players' GPS only, and
# 🧭 Route on place cards falls back to opening a map app.
# NESHAN_API_KEY=service.xxxxxxxx

# Real places & the 3D city: OpenStreetMap Overpass endpoints, tried in order (comma-separated).
# Defaults to the public servers; at scale run your own. "off" disables fetching (tiles can be uploaded by admins).
# OVERPASS_URL="https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter"

# Store menus, prices & ads (Snappfood menus/catalogs, Torob listings, Divar's latest ads per neighbourhood).
# Defaults to the real sites; "off" disables one.
# Iranian sites often refuse servers abroad: /api/health?ext=1 says whether each one answers.
# Snappfood refuses Vercel: run relay/relay.mjs on a server in Iran (relay/install.sh or `npm run relay:deploy`;
# README → "Iranian sites from abroad") and point RELAY_URL at it. RELAY_FOR lists the sites that go through it
# (default "snappfood"; e.g. "snappfood,torob,divar", or "all"). The relay forwards any public site (v2), so a
# new one is an env change, not a redeploy. A site's own *_URL below still wins.
# RELAY_URL="https://relay.example.ir/<RELAY_KEY>"
# RELAY_FOR="snappfood"
# Your SSH login on the relay server, for `npm run relay:deploy`; a password-only server: its password
# (typed at the prompts by expect — keep it only in your local .env, never commit it).
# RELAY_SSH="root@<server-ip>"
# RELAY_SSH_PASSWORD=""
# SNAPPFOOD_URL="https://snappfood.ir"
# TOROB_URL="https://api.torob.com"
# Milliseconds between Torob calls (it starts asking "are you a robot?" when hammered; the
# server also stops for half an hour when it does). 0 only against a local stub.
# TOROB_GAP_MS="450"
# DIVAR_URL="https://api.divar.ir"
# Takhfifan (deals and cashback at stores near you, a map layer): its /nearby map by position, a store's page and comments
# (through the relay: add "takhfifan" to RELAY_FOR).
# TAKHFIFAN_URL="https://takhfifan.com"
# Yemeksepeti (Turkey — Istanbul's store cards and map layer; lib/yemeksepeti.ts): its vendor gateway and its
# reviews service ("off" disables either). Asked straight, never through the Iran relay.
# YEMEKSEPETI_URL="https://tr.fd-api.com"
# YEMEKSEPETI_REVIEWS_URL="https://reviews-api-tr.fd-api.com"
# Iran's store sites (src/server/storeSites.ts, /api/stores; map layers under "Store sites"): Bilbooard and Irangaah
# (business directories), Okala (supermarkets that deliver), Netbarg (group deals), Sheypoor (classified ads by
# neighbourhood), Basalam (products by seller's city). Each "off" turns it off; through the relay add its name to RELAY_FOR.
# BILBOOARD_URL="https://bilbooard.ir"
# IRANGAAH_URL="https://irangaah.ir"
# OKALA_URL="https://apigateway.okala.com/api"
# NETBARG_URL="https://netbarg.com"
# SHEYPOOR_URL="https://www.sheypoor.com"
# BASALAM_URL="https://search.basalam.com"
# How long the map waits for a slow store site before answering with what came back (the rest keeps loading):
# STORE_WAIT_MS="9000"
# Stores' real phone numbers (all of them, shown with the map's / Torob's own) come from Balad — Snappfood only gives its own call centre:
# its name search and its place pages. Through the relay: add "balad,baladpoi" to RELAY_FOR.
# BALAD_URL="https://search.raah.ir"
# BALAD_POI_URL="https://poi.raah.ir"
# Optional: Google Places API (New) — when set, stores' numbers come from Google first and Balad only fills
# the gaps. Paid per lookup (Text Search with phone fields); cached a month, capped per day. Enable "Places API (New)"
# in Google Cloud and restrict the key to it.
# GOOGLE_PLACES_KEY=""
# GOOGLE_PLACES_PER_DAY="300"

# Sketchfab API token, only for fetching 3D model sources: npm run assets:get -- <uid> --kind=weapon
# (free account → sketchfab.com/settings/password → API token). Not used by the running game.
SKETCHFAB_TOKEN=""

# Piper (offline text to speech), only for recording what people say in the open city:
# npm run assets:voices -- --download (github.com/rhasspy/piper). Not used by the running game.
# PIPER="/path/to/piper"

# Spoken Persian for what people in the open city say (/api/tts, cached for good by the CDN).
# Azure Speech (Persian neural voices; free tier is plenty): portal.azure.com → Speech service → Keys.
# AZURE_SPEECH_KEY=""
# AZURE_SPEECH_REGION="westeurope"
# …or OpenAI (gpt-4o-mini-tts):
# OPENAI_API_KEY=""

# Cinemas and sessions (cinematicket.org's own JSON API; "off" disables it).
# CINEMATICKET_URL="https://cinematicket.org/api/v1"

# Admin → Model update stores replacement 3D models here (Vercel Blob → Storage → create a store → token).
# Unset: files go to public/uploads/models/ (development only; a production server needs the token).
# BLOB_READ_WRITE_TOKEN=""
