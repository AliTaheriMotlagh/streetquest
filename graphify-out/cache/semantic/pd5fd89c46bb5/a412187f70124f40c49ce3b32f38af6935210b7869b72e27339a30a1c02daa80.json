{"nodes": [{"id": "readme_streetquest", "label": "StreetQuest (real-world GPS war game)", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several genres stacked on one real-world map; every layer feeds the others (hero bonuses change battle maths, mood scales XP, loot funds research, territory funds the army)."}, {"id": "readme_strategy_layer", "label": "Strategy Layer (Generals: Zero Hour style)", "file_type": "concept", "source_file": "README.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rules are pure and shared between client and server (src/lib/rts.ts); battles are auto-resolved."}, {"id": "readme_life_sim_layer", "label": "Life Sim Layer (Sims-style needs)", "file_type": "concept", "source_file": "README.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs decay is computed from a stored snapshot + timestamp so no background jobs are required; mood multiplies XP in grant()."}, {"id": "readme_fps_breach", "label": "FPS Base Breach Matches", "file_type": "concept", "source_file": "README.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arena generated from match seed on every client; clients POST position + hits ~7x/s over HTTP polling; server owns HP/kills/result; first live human hosts bot/boss AI with failover. Casual-grade anti-cheat; move to WebSockets for scale."}, {"id": "readme_world_bosses", "label": "World Bosses", "file_type": "concept", "source_file": "README.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic per ~1.3 km region and 2 h window like spawns; only damage is stored; killing hit pays every contributor."}, {"id": "r