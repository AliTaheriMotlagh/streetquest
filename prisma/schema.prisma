// PostgreSQL everywhere: Docker locally (docker compose up -d), Neon/Vercel Postgres in production.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("PLAYER") // PLAYER | ADMIN
  banned       Boolean  @default(false)
  avatar       String   @default("🕶️")
  xp           Int      @default(0)
  coins        Int      @default(100)
  timezone     String   @default("UTC")
  lastLat      Float?
  lastLng      Float?
  lastSeenAt   DateTime?
  streak       Int      @default(0)
  lastDailyKey String? // YYYY-MM-DD in the user's own timezone
  referralCode String   @unique
  referredById String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime @default(now())

  // Strategy layer
  faction      String? // coalition | dragon | insurgency

  // Life-sim layer: needs (0-100) as of needsAt; they decay in real time.
  hunger       Float    @default(80)
  energy       Float    @default(80)
  social       Float    @default(60)
  fun          Float    @default(60)
  needsAt      DateTime @default(now())
  restedAt     DateTime?
  socialAt     DateTime?

  // RPG layer
  heroClass    String?
  str          Int      @default(5)
  agi          Int      @default(5)
  int          Int      @default(5)
  cha          Int      @default(5)
  scrap        Int      @default(0)
  campaignStep Int      @default(0)
  buffUntil    DateTime? // Battle Cry
  buffMult     Float    @default(1)

  // Clash-style progression
  trophies     Int      @default(0)
  gems         Int      @default(25)

  // Tower-defense layer: the commander's own HP on the street (towers shoot it).
  hp           Int      @default(100)
  hpAt         DateTime @default(now()) // HP regenerates from this snapshot
  downedUntil  DateTime?
  sabotageAt   DateTime?
  shotAt       DateTime? // street combat cooldown

  inventory     InventoryItem[]
  claims        Claim[]
  runs          MissionRun[]
  achievements  UserAchievement[]
  sentFriends   Friendship[]       @relation("requester")
  recvFriends   Friendship[]       @relation("addressee")
  messages      Message[]
  geoNotes      GeoNote[]
  deliveriesOut Delivery[]         @relation("sender")
  deliveriesIn  Delivery[]         @relation("courier")
  eventsCreated Event[]
  eventsJoined  EventParticipant[]
  notifications Notification[]
  base          Base?
  units         UnitStack[]
  trainOrders   TrainOrder[]
  battles       Battle[]
  bossHits      BossHit[]
  gear          Gear[]
  research      Research[]
  powers        PowerState[]
  quests        QuestProgress[]
  outposts      Outpost[]
  lobbies       LobbyPlayer[]
  towers        Tower[]
  squads        Squad[]
  pings         Ping[]
  superstrikes  Superstrike[]
  flags         Flag[]
  noteReactions NoteReaction[]
  bountiesOn    Bounty[]           @relation("bountyTarget")
  bountiesPosted Bounty[]          @relation("bountyPoster")

  @@index([lastSeenAt])
  @@index([trophies])
  @@index([lastLat, lastLng])
}

// In-app notifications, delivered to clients by polling /api/sync.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("info")
  title     String
  body      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model InventoryItem {
  id      String @id @default(cuid())
  userId  String
  itemKey String
  qty     Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
}

// One row per (player, spawn) — everyone sees the same spawns, each can claim once.
model Claim {
  id        String   @id @default(cuid())
  userId    String
  spawnId   String
  kind      String
  cell      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spawnId])
  @@index([userId, createdAt])
}

// GTA-style timed run: start at A, reach B before the deadline.
model MissionRun {
  id          String   @id @default(cuid())
  userId      String
  spawnId     String
  title       String
  targetLat   Float
  targetLng   Float
  deadline    DateTime
  rewardXp    Int
  rewardCoins Int
  lobbyId     String? // squad run (race / co-op)
  status      String   @default("ACTIVE") // ACTIVE | DONE | FAILED
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model UserAchievement {
  id        String   @id @default(cuid())
  userId    String
  key       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime @default(now())
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

// room: "global" | "local:<cell>" | "dm:<idA>:<idB>" (ids sorted) | "event:<id>"
model Message {
  id        String   @id @default(cuid())
  room      String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([room, createdAt])
}

// A message pinned to a real place — only readable when you stand there.
model GeoNote {
  id        String   @id @default(cuid())
  authorId  String
  lat       Float
  lng       Float
  radiusM   Int      @default(50)
  body      String
  hidden    Boolean  @default(false)
  photo     Bytes? // resized JPEG/WebP, ≤ 400 KB, only served to players standing there
  photoType String?
  likes     Int      @default(0)
  reports   Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([lat, lng])
}

// Real-world package transfer requested by a player, fulfilled by a courier.
model Delivery {
  id            String    @id @default(cuid())
  senderId      String
  courierId     String?
  title         String
  description   String
  pickupLabel   String
  pickupLat     Float
  pickupLng     Float
  dropoffLabel  String
  dropoffLat    Float
  dropoffLng    Float
  reward        Int // coins held in escrow from the sender
  dropoffCode   String // sender gives this to the recipient; courier enters it on handover
  status        String    @default("OPEN") // OPEN | ACCEPTED | PICKED_UP | DELIVERED | CANCELLED
  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  sender        User      @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  courier       User?     @relation("courier", fields: [courierId], references: [id])

  @@index([status, pickupLat, pickupLng])
}

model Event {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  description  String
  lat          Float
  lng          Float
  radiusM      Int                @default(80)
  startsAt     DateTime
  endsAt       DateTime
  creatorId    String
  official     Boolean            @default(false)
  isPublic     Boolean            @default(true)
  maxPlayers   Int                @default(50)
  rewardXp     Int                @default(200)
  rewardCoins  Int                @default(50)
  createdAt    DateTime           @default(now())
  creator      User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  participants EventParticipant[]
}

model EventParticipant {
  id          String    @id @default(cuid())
  eventId     String
  userId      String
  checkedInAt DateTime?
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// Hand-placed missions from the admin panel (sponsored drops, campaigns...).
model AdminMission {
  id          String   @id @default(cuid())
  title       String
  description String
  lat         Float
  lng         Float
  itemKey     String
  rewardXp    Int      @default(150)
  rewardCoins Int      @default(50)
  activeFrom  DateTime
  activeTo    DateTime
  sponsor     String?
  createdAt   DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  ctaLabel  String?
  ctaUrl    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Lightweight first-party analytics for marketing funnels.
model Metric {
  id        String   @id @default(cuid())
  name      String // page_view | signup | claim | delivery_created ...
  userId    String?
  path      String?
  source    String?
  campaign  String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

// ---------------------------------------------------------------- Strategy layer
// One base per player, planted at a real location.
model Base {
  id            String     @id @default(cuid())
  ownerId       String     @unique
  name          String
  lat           Float
  lng           Float
  hp            Int        @default(1000)
  lastCollectAt DateTime   @default(now())
  shieldUntil   DateTime?
  createdAt     DateTime   @default(now())
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  buildings     Building[]

  @@index([lat, lng])
}

model Building {
  id      String   @id @default(cuid())
  baseId  String
  type    String
  level   Int      @default(1)
  readyAt DateTime // construction / upgrade finishes at this time
  base    Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@unique([baseId, type])
}

model UnitStack {
  id       String @id @default(cuid())
  userId   String
  unitType String
  qty      Int    @default(0)
  vet      Float  @default(0) // veterancy XP of the stack (Rookie → Heroic)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, unitType])
}

model TrainOrder {
  id       String   @id @default(cuid())
  userId   String
  unitType String
  qty      Int
  readyAt  DateTime
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readyAt])
}

// Auto-resolved fights (sieges, derrick raids, boss bombardments) and finished FPS matches.
model Battle {
  id         String   @id @default(cuid())
  attackerId String
  kind       String // siege | derrick | boss | breach | raid
  targetId   String
  targetName String
  won        Boolean
  loot       Int      @default(0)
  stars      Int      @default(0)
  destruction Int     @default(0)
  trophies   Int      @default(0) // attacker's trophy change
  defenderId String?
  log        Json
  createdAt  DateTime @default(now())
  attacker   User     @relation(fields: [attackerId], references: [id], onDelete: Cascade)

  @@index([attackerId, createdAt])
  @@index([targetId, createdAt])
  @@index([defenderId, createdAt])
}

// ---------------------------------------------------------------- FPS layer
// A live first-person fight. Clients poll /api/match/:id ~7x/s. The host client
// (first live human) simulates bots/boss; the server owns HP and the outcome.
model Match {
  id        String        @id @default(cuid())
  kind      String // breach | raid
  targetId  String // baseId | bossId
  seed      Int
  hostKey   String?
  status    String        @default("LIVE") // LIVE | ENDED
  winner    String? // A (attackers) | D (defenders/boss)
  capture   Float         @default(0) // seconds attackers have held the objective
  feed      Json          @default("[]") // kill feed: [{t, text}]
  endsAt    DateTime
  createdAt DateTime      @default(now())
  players   MatchPlayer[]

  @@index([targetId, status])
}

model MatchPlayer {
  id         String   @id @default(cuid())
  matchId    String
  key        String // userId, or "bot:N" / "boss"
  userId     String?
  team       String // A | D
  name       String
  x          Float    @default(0)
  z          Float    @default(0)
  yaw        Float    @default(0)
  hp         Int      @default(100)
  maxHp      Int      @default(100)
  weapon     String   @default("ar") // from the hero's equipped weapon
  dmgMult    Float    @default(1)
  headBonus  Float    @default(0)
  speedMult  Float    @default(1)
  kills      Int      @default(0)
  damage     Int      @default(0)
  lastShotAt DateTime?
  updatedAt  DateTime @default(now())
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, key])
}

// World bosses are deterministic (like spawns); only damage taken is stored.
model BossState {
  bossId     String    @id
  damage     Int       @default(0)
  defeatedAt DateTime?
  hits       BossHit[]
}

model BossHit {
  id     String    @id @default(cuid())
  bossId String
  userId String
  damage Int       @default(0)
  boss   BossState @relation(fields: [bossId], references: [bossId], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bossId, userId])
}

// ---------------------------------------------------------------- RPG layer
model Gear {
  id        String   @id @default(cuid())
  userId    String
  slot      String // weapon | armor | gadget
  base      String
  name      String
  rarity    String
  level     Int
  affixes   Json // [{ key, q }]
  equipped  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, equipped])
}

model Research {
  id      String   @id @default(cuid())
  userId  String
  key     String
  readyAt DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model PowerState {
  id         String    @id @default(cuid())
  userId     String
  key        String
  rank       Int       @default(1)
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// key: "c:<step>" (campaign) or "d:<YYYY-MM-DD>:<n>" (daily)
model QuestProgress {
  id       String  @id @default(cuid())
  userId   String
  key      String
  progress Int     @default(0)
  claimed  Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Territory: outpost positions are deterministic; only who holds them is stored.
model Outpost {
  id          String    @id // op.<cx>_<cy>
  ownerId     String?
  garrison    Json      @default("{}")
  capturedAt  DateTime?
  collectedAt DateTime?
  shieldUntil DateTime?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

// ---------------------------------------------------------------- Multiplayer lobbies
// Everyone sees the same spawns, so a lobby lives at a spawn: arcade duels (range),
// chest co-ops (defuse) and squad runs (race / coop). All players get the same seed.
model Lobby {
  id        String        @id @default(cuid())
  kind      String // range | defuse | race | coop
  spawnId   String
  seed      Int
  hostId    String
  lat       Float
  lng       Float
  status    String        @default("OPEN") // OPEN | LIVE | ENDED
  openUntil DateTime // auto-start time
  startsAt  DateTime? // end of the 3-2-1 countdown
  endsAt    DateTime?
  createdAt DateTime      @default(now())
  players   LobbyPlayer[]

  @@index([spawnId, status])
  @@index([status, lat, lng])
}

model LobbyPlayer {
  id         String    @id @default(cuid())
  lobbyId    String
  userId     String
  name       String
  avatar     String
  score      Int?
  place      Int?
  finishedAt DateTime?
  reward     String?
  joinedAt   DateTime  @default(now())
  lobby      Lobby     @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- Tower defense
// Towers stand on real streets. They shoot hostile players who walk into range
// and every raider wave that marches past.
model Tower {
  id        String   @id @default(cuid())
  ownerId   String
  type      String
  level     Int      @default(1)
  lat       Float
  lng       Float
  hp        Int
  kills     Int      @default(0)
  readyAt   DateTime
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([lat, lng])
  @@index([ownerId])
}

// Army units deployed onto the map. Position is interpolated from the march, so
// no background job is needed; arrivals are settled whenever someone looks.
model Squad {
  id         String   @id @default(cuid())
  ownerId    String
  units      Json // Army
  vets       Json     @default("{}")
  fromLat    Float
  fromLng    Float
  toLat      Float
  toLng      Float
  departAt   DateTime @default(now())
  arriveAt   DateTime
  order      String // guard | attack | return
  targetKind String? // tower | squad
  targetId   String?
  status     String   @default("MARCH") // MARCH | HOLD
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([toLat, toLng])
  @@index([fromLat, fromLng])
  @@index([ownerId])
}

// A raider wave against one base. The creeps are generated from the seed, the
// fight is a deterministic simulation (server resolves, clients animate it).
model Wave {
  id         String    @id @default(cuid())
  baseId     String
  seed       Int
  hq         Int
  boost      Float     @default(1) // provoked waves are tougher and pay more
  startAt    DateTime
  endAt      DateTime
  strikes    Json      @default("[]") // [{ by, name, t, lat, lng }]
  result     Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([baseId, resolvedAt])
  @@index([startAt])
  @@index([resolvedAt])
}

// Short-lived map markers for crew coordination.
model Ping {
  id        String   @id @default(cuid())
  userId    String
  kind      String // attack | help | rally | loot
  lat       Float
  lng       Float
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([lat, lng])
}

// Faction superweapons (Generals-style): Nuclear Missile, Particle Cannon, SCUD Storm.
// A launch is public: everyone near the target sees the countdown and can run.
model Superstrike {
  id          String    @id @default(cuid())
  ownerId     String
  kind        String // nuke | particle | scud
  level       Int       @default(1)
  lat         Float
  lng         Float
  radius      Int
  launchAt    DateTime  @default(now())
  impactAt    DateTime
  hazardUntil DateTime?
  resolvedAt  DateTime?
  result      Json?
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([lat, lng])
  @@index([ownerId, launchAt])
  @@index([impactAt])
}

// One like/report per player per post.
model NoteReaction {
  id     String @id @default(cuid())
  noteId String
  userId String
  kind   String // like | report
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId, kind])
}

// King of the hill: a flag planted on a real spot. Rivals capture it by standing
// there for a minute while no defender is around; the holder earns tribute.
model Flag {
  id               String    @id @default(cuid())
  ownerId          String
  name             String
  lat              Float
  lng              Float
  plantedAt        DateTime  @default(now())
  heldSince        DateTime  @default(now())
  collectedAt      DateTime  @default(now())
  captures         Int       @default(0)
  captureById      String?
  captureName      String?
  captureStartedAt DateTime?
  shieldUntil      DateTime?
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([lat, lng])
  @@index([ownerId])
}

// Coins on a rival's head; whoever downs them collects. Escrowed from the poster.
model Bounty {
  id          String    @id @default(cuid())
  targetId    String
  posterId    String
  amount      Int
  createdAt   DateTime  @default(now())
  claimedById String?
  claimedAt   DateTime?
  target      User      @relation("bountyTarget", fields: [targetId], references: [id], onDelete: Cascade)
  poster      User      @relation("bountyPoster", fields: [posterId], references: [id], onDelete: Cascade)

  @@index([targetId, claimedAt])
  @@index([createdAt])
}
