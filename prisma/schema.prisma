// PostgreSQL everywhere: Docker locally (docker compose up -d), Neon/Vercel Postgres in production.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         String    @default("PLAYER") // PLAYER | ADMIN
  banned       Boolean   @default(false)
  avatar       String    @default("🕶️")
  xp           Int       @default(0)
  coins        Int       @default(100)
  timezone     String    @default("UTC")
  lastLat      Float?
  lastLng      Float?
  lastSeenAt   DateTime?
  locAt        DateTime? // when lastLat/lastLng was accepted (speed checks measure from here)
  streak       Int       @default(0)
  lastDailyKey String? // YYYY-MM-DD in the user's own timezone
  referralCode String    @unique
  referredById String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime  @default(now())

  // Strategy layer
  faction String? // coalition | dragon | insurgency

  // Life-sim layer: needs (0-100) as of needsAt; they decay in real time.
  hunger   Float     @default(80)
  energy   Float     @default(80)
  social   Float     @default(60)
  fun      Float     @default(60)
  needsAt  DateTime  @default(now())
  restedAt DateTime?
  socialAt DateTime?

  // RPG layer
  heroClass    String?
  str          Int       @default(5)
  agi          Int       @default(5)
  int          Int       @default(5)
  cha          Int       @default(5)
  scrap        Int       @default(0)
  campaignStep Int       @default(0)
  buffUntil    DateTime? // Battle Cry
  buffMult     Float     @default(1)

  // Clash-style progression
  trophies Int @default(0)
  gems     Int @default(25)

  // Tower-defense layer: the commander's own HP on the street (towers shoot it).
  hp          Int       @default(100)
  hpAt        DateTime  @default(now()) // HP regenerates from this snapshot
  downedUntil DateTime?
  sabotageAt  DateTime?
  shotAt      DateTime? // street combat cooldown

  // Lifetime distance moved on foot (metres, from accepted GPS fixes) and story progress.
  walkedM      Float @default(0)
  storyChapter Int   @default(0)

  // Play from home: move by tapping the map at a capped speed, for reduced rewards.
  remotePlay Boolean @default(false)

  // UI language ("en" | "fa"): notifications and pushes are written in it.
  locale String @default("en")

  // Steps walked, ever (the per-day breakdown is in StepDay).
  stepsTotal Int @default(0)

  // Social profile: a short bio under the name, shown on the profile page.
  bio String @default("")

  // Money on the map: the toman wallet (cash-out at S.cashoutMin) and whether the
  // last accepted position came from test mode (which never earns toman). moneyTier:
  // how many of S.moneyTiers (bigger money on the map) they've bought, in order.
  toman     Int     @default(0)
  locSim    Boolean @default(false)
  moneyTier Int     @default(0)

  inventory       InventoryItem[]
  claims          Claim[]
  runs            MissionRun[]
  achievements    UserAchievement[]
  sentFriends     Friendship[]       @relation("requester")
  recvFriends     Friendship[]       @relation("addressee")
  messages        Message[]
  geoNotes        GeoNote[]
  deliveriesOut   Delivery[]         @relation("sender")
  deliveriesIn    Delivery[]         @relation("courier")
  ridesTaken      Ride[]             @relation("rider")
  ridesDriven     Ride[]             @relation("driver")
  lotteriesHosted Lottery[]          @relation("lotteryHost")
  lotteriesWon    Lottery[]          @relation("lotteryWinner")
  lotteryTickets  LotteryTicket[]
  eventsCreated   Event[]
  eventsJoined    EventParticipant[]
  notifications   Notification[]
  base            Base?
  units           UnitStack[]
  trainOrders     TrainOrder[]
  battles         Battle[]
  bossHits        BossHit[]
  gear            Gear[]
  research        Research[]
  powers          PowerState[]
  quests          QuestProgress[]
  outposts        Outpost[]
  lobbies         LobbyPlayer[]
  towers          Tower[]
  squads          Squad[]
  pings           Ping[]
  superstrikes    Superstrike[]
  flags           Flag[]
  noteReactions   NoteReaction[]
  bountiesOn      Bounty[]           @relation("bountyTarget")
  bountiesPosted  Bounty[]           @relation("bountyPoster")
  goalClaims      GoalClaim[]
  purchases       Purchase[]
  adViews         AdView[]
  gpsGames        GpsGame[]
  pushSubs        PushSub[]
  callsOut        Call[]             @relation("caller")
  callsIn         Call[]             @relation("callee")
  shop            Shop?
  shopOrders      ShopOrder[]        @relation("shopBuyer")
  empire          Empire?
  stepDays        StepDay[]
  business        Business[]
  bizVisits       BizVisit[]
  posts           Post[]
  cashouts        Cashout[]
  postLikes       PostLike[]
  postComments    PostComment[]
  following       Follow[]           @relation("follower")
  followers       Follow[]           @relation("followee")

  @@index([lastSeenAt])
  @@index([trophies])
  @@index([lastLat, lastLng])
}

// In-app notifications, delivered to clients by polling /api/sync.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    @default("info")
  // What the game should do with it, independent of the (translated) text:
  // "incoming" (siren), "levelup" (celebration), "hurt".
  tag       String?
  title     String
  body      String?
  // Where tapping it goes: a panel id ("base", "play", "me:quests"…).
  link      String?
  // One-off alerts (a timer that finished, the daily drop) carry a key so they're sent once
  // (checked in server/alerts.ts; an index, not a unique constraint, so deploys never stop on it).
  key       String?
  readAt    DateTime? // seen in the inbox
  // Dismissed keyed alerts are hidden rather than deleted, so their key still stops a resend.
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, key])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([createdAt])
}

model InventoryItem {
  id      String @id @default(cuid())
  userId  String
  itemKey String
  qty     Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
}

// One row per (player, spawn) — everyone sees the same spawns, each can claim once.
model Claim {
  id        String   @id @default(cuid())
  userId    String
  spawnId   String
  kind      String
  cell      String
  toman     Int      @default(0) // toman paid for it (money pickups, store missions)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spawnId])
  @@index([userId, createdAt])
}

// GTA-style timed run: start at A, reach B before the deadline.
model MissionRun {
  id          String   @id @default(cuid())
  userId      String
  spawnId     String
  title       String
  targetLat   Float
  targetLng   Float
  deadline    DateTime
  rewardXp    Int
  rewardCoins Int
  lobbyId     String? // squad run (race / co-op)
  status      String   @default("ACTIVE") // ACTIVE | DONE | FAILED
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model UserAchievement {
  id        String   @id @default(cuid())
  userId    String
  key       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime @default(now())
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

// room: "global" | "local:<cell>" | "dm:<idA>:<idB>" (ids sorted) | "event:<id>"
model Message {
  id        String   @id @default(cuid())
  room      String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([room, createdAt])
}

// A message pinned to a real place — only readable when you stand there.
model GeoNote {
  id        String   @id @default(cuid())
  authorId  String
  lat       Float
  lng       Float
  radiusM   Int      @default(50)
  body      String
  hidden    Boolean  @default(false)
  photo     Bytes? // resized JPEG/WebP, ≤ 400 KB, only served to players standing there
  photoType String?
  likes     Int      @default(0)
  reports   Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([lat, lng])
}

// Real-world package transfer requested by a player, fulfilled by a courier.
model Delivery {
  id           String    @id @default(cuid())
  senderId     String
  courierId    String?
  title        String
  description  String
  pickupLabel  String
  pickupLat    Float
  pickupLng    Float
  dropoffLabel String
  dropoffLat   Float
  dropoffLng   Float
  reward       Int // coins held in escrow from the sender
  dropoffCode  String // sender gives this to the recipient; courier enters it on handover
  status       String    @default("OPEN") // OPEN | ACCEPTED | PICKED_UP | DELIVERED | CANCELLED
  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  sender       User      @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  courier      User?     @relation("courier", fields: [courierId], references: [id])

  @@index([status, pickupLat, pickupLng])
}

// In-game ride hailing: a player requests a car, another player drives them.
model Ride {
  id           String    @id @default(cuid())
  riderId      String
  driverId     String?
  pickupLabel  String
  pickupLat    Float
  pickupLng    Float
  dropoffLabel String
  dropoffLat   Float
  dropoffLng   Float
  seats        Int       @default(1)
  note         String    @default("")
  fare         Int // coins held in escrow from the rider
  pin          String // rider tells the driver at pickup; proves they actually met
  status       String    @default("REQUESTED") // REQUESTED | ACCEPTED | ONBOARD | DONE | CANCELLED
  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  rider        User      @relation("rider", fields: [riderId], references: [id], onDelete: Cascade)
  driver       User?     @relation("driver", fields: [driverId], references: [id])

  @@index([status, pickupLat, pickupLng])
  @@index([riderId, status])
  @@index([driverId, status])
}

// Lottery at a real place: buy tickets there, at drawAt one random ticket takes the whole pot.
model Lottery {
  id          String          @id @default(cuid())
  name        String
  lat         Float
  lng         Float
  radiusM     Int             @default(60)
  ticketPrice Int
  maxTickets  Int             @default(10) // per player
  drawAt      DateTime
  hostId      String
  official    Boolean         @default(false)
  pot         Int             @default(0)
  status      String          @default("OPEN") // OPEN | DRAWN | REFUNDED
  winnerId    String?
  drawnAt     DateTime?
  createdAt   DateTime        @default(now())
  host        User            @relation("lotteryHost", fields: [hostId], references: [id], onDelete: Cascade)
  winner      User?           @relation("lotteryWinner", fields: [winnerId], references: [id])
  tickets     LotteryTicket[]

  @@index([status, drawAt])
  @@index([lat, lng])
}

model LotteryTicket {
  id        String  @id @default(cuid())
  lotteryId String
  userId    String
  qty       Int     @default(0)
  lottery   Lottery @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lotteryId, userId])
  @@index([userId])
}

model Event {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  description  String
  lat          Float
  lng          Float
  radiusM      Int                @default(80)
  startsAt     DateTime
  endsAt       DateTime
  creatorId    String
  official     Boolean            @default(false)
  isPublic     Boolean            @default(true)
  maxPlayers   Int                @default(50)
  rewardXp     Int                @default(200)
  rewardCoins  Int                @default(50)
  createdAt    DateTime           @default(now())
  creator      User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  participants EventParticipant[]
}

model EventParticipant {
  id          String    @id @default(cuid())
  eventId     String
  userId      String
  checkedInAt DateTime?
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// Hand-placed missions from the admin panel (sponsored drops, campaigns...).
// Money an admin dropped on the map (a spot, or a street as a row of drops sharing a
// batch). Each player can pick each drop up once; maxClaims caps the total budget.
model MoneyDrop {
  id         String   @id @default(cuid())
  batch      String
  label      String
  sponsor    String?
  lat        Float
  lng        Float
  amount     Int // toman for a player on GPS (from home: scaled by S.moneyHome / S.moneyGps)
  maxClaims  Int? // null = unlimited
  claims     Int      @default(0)
  paid       Int      @default(0) // toman paid out so far
  activeFrom DateTime
  activeTo   DateTime
  createdAt  DateTime @default(now())

  @@index([lat, lng])
  @@index([batch])
}

// A player asking to be paid their toman. The amount leaves the wallet on request and
// comes back if an admin rejects it.
model Cashout {
  id        String    @id @default(cuid())
  userId    String
  amount    Int
  fullName  String
  phone     String
  account   String // 16-digit bank card or IR Sheba
  status    String    @default("PENDING") // PENDING | PAID | REJECTED
  note      String?
  createdAt DateTime  @default(now())
  decidedAt DateTime?
  decidedBy String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model AdminMission {
  id          String   @id @default(cuid())
  title       String
  description String
  lat         Float
  lng         Float
  itemKey     String
  rewardXp    Int      @default(150)
  rewardCoins Int      @default(50)
  activeFrom  DateTime
  activeTo    DateTime
  sponsor     String?
  createdAt   DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  ctaLabel  String?
  ctaUrl    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Lightweight first-party analytics for marketing funnels.
model Metric {
  id        String   @id @default(cuid())
  name      String // page_view | signup | claim | delivery_created ...
  userId    String?
  path      String?
  source    String?
  campaign  String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

// ---------------------------------------------------------------- Strategy layer
// One base per player, planted at a real location.
model Base {
  id            String     @id @default(cuid())
  ownerId       String     @unique
  name          String
  lat           Float
  lng           Float
  hp            Int        @default(1000)
  lastCollectAt DateTime   @default(now())
  shieldUntil   DateTime?
  createdAt     DateTime   @default(now())
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  buildings     Building[]

  @@index([lat, lng])
}

model Building {
  id      String   @id @default(cuid())
  baseId  String
  type    String
  level   Int      @default(1)
  readyAt DateTime // construction / upgrade finishes at this time
  base    Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@unique([baseId, type])
}

model UnitStack {
  id       String @id @default(cuid())
  userId   String
  unitType String
  qty      Int    @default(0)
  vet      Float  @default(0) // veterancy XP of the stack (Rookie → Heroic)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, unitType])
}

model TrainOrder {
  id       String   @id @default(cuid())
  userId   String
  unitType String
  qty      Int
  readyAt  DateTime
  unitMs   Int      @default(0) // time per unit: finished units are delivered one by one
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readyAt])
}

// Auto-resolved fights (sieges, derrick raids, boss bombardments) and finished FPS matches.
model Battle {
  id          String   @id @default(cuid())
  attackerId  String
  kind        String // siege | derrick | boss | breach | raid
  targetId    String
  targetName  String
  won         Boolean
  loot        Int      @default(0)
  stars       Int      @default(0)
  destruction Int      @default(0)
  trophies    Int      @default(0) // attacker's trophy change
  defenderId  String?
  log         Json
  createdAt   DateTime @default(now())
  attacker    User     @relation(fields: [attackerId], references: [id], onDelete: Cascade)

  @@index([attackerId, createdAt])
  @@index([targetId, createdAt])
  @@index([defenderId, createdAt])
}

// ---------------------------------------------------------------- FPS layer
// A live first-person fight. Clients poll /api/match/:id ~7x/s. The host client
// (first live human) simulates bots/boss; the server owns HP and the outcome.
model Match {
  id        String        @id @default(cuid())
  kind      String // breach | raid
  targetId  String // baseId | bossId
  seed      Int
  hostKey   String?
  status    String        @default("LIVE") // LIVE | ENDED
  winner    String? // A (attackers) | D (defenders/boss)
  capture   Float         @default(0) // seconds attackers have held the objective
  feed      Json          @default("[]") // kill feed: [{t, text}]
  endsAt    DateTime
  createdAt DateTime      @default(now())
  players   MatchPlayer[]

  @@index([targetId, status])
}

model MatchPlayer {
  id         String    @id @default(cuid())
  matchId    String
  key        String // userId, or "bot:N" / "boss"
  userId     String?
  team       String // A | D
  name       String
  x          Float     @default(0)
  z          Float     @default(0)
  yaw        Float     @default(0)
  hp         Int       @default(100)
  maxHp      Int       @default(100)
  weapon     String    @default("ar") // from the hero's equipped weapon
  dmgMult    Float     @default(1)
  headBonus  Float     @default(0)
  speedMult  Float     @default(1)
  kills      Int       @default(0)
  damage     Int       @default(0)
  lastShotAt DateTime?
  updatedAt  DateTime  @default(now())
  match      Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, key])
}

// World bosses are deterministic (like spawns); only damage taken is stored.
model BossState {
  bossId     String    @id
  damage     Int       @default(0)
  defeatedAt DateTime?
  hits       BossHit[]
}

model BossHit {
  id     String    @id @default(cuid())
  bossId String
  userId String
  damage Int       @default(0)
  boss   BossState @relation(fields: [bossId], references: [bossId], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bossId, userId])
}

// ---------------------------------------------------------------- RPG layer
model Gear {
  id        String   @id @default(cuid())
  userId    String
  slot      String // weapon | armor | gadget
  base      String
  name      String
  rarity    String
  level     Int
  affixes   Json // [{ key, q }]
  equipped  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, equipped])
}

model Research {
  id      String   @id @default(cuid())
  userId  String
  key     String
  readyAt DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model PowerState {
  id         String    @id @default(cuid())
  userId     String
  key        String
  rank       Int       @default(1)
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// key: "c:<step>" (campaign) or "d:<YYYY-MM-DD>:<n>" (daily)
model QuestProgress {
  id       String  @id @default(cuid())
  userId   String
  key      String
  progress Int     @default(0)
  claimed  Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Territory: outpost positions are deterministic; only who holds them is stored.
model Outpost {
  id          String    @id // op.<cx>_<cy>
  ownerId     String?
  garrison    Json      @default("{}")
  capturedAt  DateTime?
  collectedAt DateTime?
  shieldUntil DateTime?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

// ---------------------------------------------------------------- Multiplayer lobbies
// Everyone sees the same spawns, so a lobby lives at a spawn: arcade duels (range),
// chest co-ops (defuse) and squad runs (race / coop). All players get the same seed.
model Lobby {
  id        String        @id @default(cuid())
  kind      String // range | defuse | race | coop
  spawnId   String
  seed      Int
  hostId    String
  lat       Float
  lng       Float
  status    String        @default("OPEN") // OPEN | LIVE | ENDED
  openUntil DateTime // auto-start time
  startsAt  DateTime? // end of the 3-2-1 countdown
  endsAt    DateTime?
  createdAt DateTime      @default(now())
  players   LobbyPlayer[]

  @@index([spawnId, status])
  @@index([status, lat, lng])
}

model LobbyPlayer {
  id         String    @id @default(cuid())
  lobbyId    String
  userId     String
  name       String
  avatar     String
  score      Int?
  place      Int?
  finishedAt DateTime?
  reward     String?
  joinedAt   DateTime  @default(now())
  lobby      Lobby     @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- Tower defense
// Towers stand on real streets. They shoot hostile players who walk into range
// and every raider wave that marches past.
model Tower {
  id        String   @id @default(cuid())
  ownerId   String
  type      String
  level     Int      @default(1)
  lat       Float
  lng       Float
  hp        Int
  kills     Int      @default(0)
  readyAt   DateTime
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([lat, lng])
  @@index([ownerId])
}

// Army units deployed onto the map. Position is interpolated from the march, so
// no background job is needed; arrivals are settled whenever someone looks.
model Squad {
  id         String   @id @default(cuid())
  ownerId    String
  units      Json // Army
  vets       Json     @default("{}")
  fromLat    Float
  fromLng    Float
  toLat      Float
  toLng      Float
  departAt   DateTime @default(now())
  arriveAt   DateTime
  order      String // guard | attack | return
  targetKind String? // tower | squad
  targetId   String?
  status     String   @default("MARCH") // MARCH | HOLD
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([toLat, toLng])
  @@index([fromLat, fromLng])
  @@index([ownerId])
}

// A raider wave against one base. The creeps are generated from the seed, the
// fight is a deterministic simulation (server resolves, clients animate it).
model Wave {
  id         String    @id @default(cuid())
  baseId     String
  seed       Int
  hq         Int
  boost      Float     @default(1) // provoked waves are tougher and pay more
  startAt    DateTime
  endAt      DateTime
  strikes    Json      @default("[]") // [{ by, name, t, lat, lng }]
  result     Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([baseId, resolvedAt])
  @@index([startAt])
  @@index([resolvedAt])
}

// Short-lived map markers for crew coordination.
model Ping {
  id        String   @id @default(cuid())
  userId    String
  kind      String // attack | help | rally | loot
  lat       Float
  lng       Float
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([lat, lng])
}

// Faction superweapons (Generals-style): Nuclear Missile, Particle Cannon, SCUD Storm.
// A launch is public: everyone near the target sees the countdown and can run.
model Superstrike {
  id          String    @id @default(cuid())
  ownerId     String
  kind        String // nuke | particle | scud
  level       Int       @default(1)
  lat         Float
  lng         Float
  radius      Int
  launchAt    DateTime  @default(now())
  impactAt    DateTime
  hazardUntil DateTime?
  resolvedAt  DateTime?
  result      Json?
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([lat, lng])
  @@index([ownerId, launchAt])
  @@index([impactAt])
}

// One like/report per player per post.
model NoteReaction {
  id     String @id @default(cuid())
  noteId String
  userId String
  kind   String // like | report
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId, kind])
}

// King of the hill: a flag planted on a real spot. Rivals capture it by standing
// there for a minute while no defender is around; the holder earns tribute.
model Flag {
  id               String    @id @default(cuid())
  ownerId          String
  name             String
  lat              Float
  lng              Float
  plantedAt        DateTime  @default(now())
  heldSince        DateTime  @default(now())
  collectedAt      DateTime  @default(now())
  captures         Int       @default(0)
  captureById      String?
  captureName      String?
  captureStartedAt DateTime?
  shieldUntil      DateTime?
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([lat, lng])
  @@index([ownerId])
}

// Coins on a rival's head; whoever downs them collects. Escrowed from the poster.
model Bounty {
  id          String    @id @default(cuid())
  targetId    String
  posterId    String
  amount      Int
  createdAt   DateTime  @default(now())
  claimedById String?
  claimedAt   DateTime?
  target      User      @relation("bountyTarget", fields: [targetId], references: [id], onDelete: Cascade)
  poster      User      @relation("bountyPoster", fields: [posterId], references: [id], onDelete: Cascade)

  @@index([targetId, claimedAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------- Live config, goals, store, GPS games
// Admin-edited game settings (one row, id "main"): overrides on top of lib/settings.ts defaults.
model GameConfig {
  id        String   @id
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Goal progress counters. scope: user | faction | world; period: "all" or a week key like "2026-W41".
model GoalCounter {
  id      String @id @default(cuid())
  scope   String
  scopeId String
  period  String
  metric  String
  value   Float  @default(0)

  @@unique([scope, scopeId, period, metric])
  @@index([period, metric])
}

// One row per reward a player has collected: "w:<week>:<goal>", "f:<week>:<goal>", "p:<goal>:<tier>".
model GoalClaim {
  id        String   @id @default(cuid())
  userId    String
  key       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// Gem purchases (Stripe Checkout). ref = the provider's session id, so crediting is idempotent.
model Purchase {
  id          String    @id @default(cuid())
  userId      String
  provider    String    @default("stripe")
  ref         String    @unique
  pack        String
  gems        Int
  amountCents Int
  currency    String
  status      String    @default("PENDING") // PENDING | PAID | FAILED
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// A rewarded sponsor spot: started → must stay open adSeconds → claimed.
model AdView {
  id         String    @id @default(cuid())
  userId     String
  creativeId String
  startedAt  DateTime  @default(now())
  claimedAt  DateTime?
  clicked    Boolean   @default(false)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([creativeId, startedAt])
}

// GPS mini-games (treasure hunt, sprint, rally) and story chapters. The hidden
// parts (treasure spot) stay on the server; the client only gets what it may see.
model GpsGame {
  id        String   @id @default(cuid())
  userId    String
  kind      String // hunt | sprint | rally | story
  data      Json
  status    String   @default("ACTIVE") // ACTIVE | WON | LOST | QUIT
  startedAt DateTime @default(now())
  endsAt    DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Web Push subscriptions (one per browser/device). Notifications are pushed when the
// player isn't in the app; dead subscriptions (404/410 from the push service) are removed.
model PushSub {
  id        String    @id @default(cuid())
  userId    String
  endpoint  String    @unique
  p256dh    String
  auth      String
  createdAt DateTime  @default(now())
  lastPush  DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 1:1 video calls between crew members. Audio/video flow peer-to-peer over WebRTC; the
// server only relays the handshake (offer, answer, ICE candidates) as CallSignal rows
// that both phones poll while the call is up.
model Call {
  id         String       @id @default(cuid())
  callerId   String
  calleeId   String
  status     String       @default("RINGING") // RINGING | ACTIVE | ENDED
  video      Boolean      @default(true) // false: a voice call (no cameras)
  endReason  String? // hangup | declined | missed | busy | lost
  createdAt  DateTime     @default(now())
  answeredAt DateTime?
  endedAt    DateTime?
  // Last poll from each side: a phone that vanished mid-call frees the other one.
  callerSeen DateTime     @default(now())
  calleeSeen DateTime     @default(now())
  caller     User         @relation("caller", fields: [callerId], references: [id], onDelete: Cascade)
  callee     User         @relation("callee", fields: [calleeId], references: [id], onDelete: Cascade)
  signals    CallSignal[]

  @@index([calleeId, status])
  @@index([callerId, status])
}

model CallSignal {
  id        Int      @id @default(autoincrement()) // ordering: ICE must follow its offer/answer
  callId    String
  fromId    String
  kind      String // offer | answer | ice | state (camera/mic on-off)
  data      String
  createdAt DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, id])
}

// One mutating action at a time per player: a double-tap or a retried request waits
// for the first to finish instead of spending twice. Rows live for one request.
model ActionLock {
  key       String   @id
  expiresAt DateTime
}

// ---------------------------------------------------------------- Player shops
// Every player can run one shop at a real place. Opening it pays for a month
// (expiresAt); renewing adds another. Products have photos, a price in coins, stock
// and an optional time-limited discount; featured ones fill the shop window. A
// purchase holds the buyer's coins in escrow until the seller hands the goods over
// and enters the buyer's pickup code.
model Shop {
  id        String      @id @default(cuid())
  ownerId   String      @unique
  name      String
  tagline   String      @default("")
  about     String      @default("")
  emoji     String      @default("🏪")
  category  String      @default("other")
  address   String      @default("") // how to find it, in the owner's words
  lat       Float
  lng       Float
  coverId   String? // ShopImage shown as the banner
  open      Boolean     @default(true) // the owner can pause sales
  expiresAt DateTime
  warnedAt  DateTime? // "about to close" reminder sent for the current month
  sales     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products  Product[]
  images    ShopImage[]
  orders    ShopOrder[]

  @@index([lat, lng])
  @@index([expiresAt])
}

model Product {
  id            String      @id @default(cuid())
  shopId        String
  title         String
  description   String      @default("")
  price         Int // coins, before any discount
  discountPct   Int         @default(0) // 0–90
  discountUntil DateTime? // null: the discount has no end date
  stock         Int         @default(1)
  featured      Boolean     @default(false) // in the shop window
  active        Boolean     @default(true) // hidden from buyers when false
  sold          Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  shop          Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  photos        ShopImage[]

  @@index([shopId, active])
}

// Shop banners and product photos. Rows never change (a new photo is a new row), so
// they're served with a long immutable cache.
model ShopImage {
  id        String   @id @default(cuid())
  shopId    String
  productId String?
  position  Int      @default(0)
  data      Bytes
  type      String
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@index([shopId])
}

model ShopOrder {
  id          String    @id @default(cuid())
  shopId      String
  buyerId     String
  productId   String? // the product may be deleted later; title/photo are a snapshot
  title       String
  photoId     String?
  qty         Int
  unitPrice   Int // what the buyer paid per item (after discount)
  total       Int // held in escrow until handover
  fee         Int       @default(0) // market fee, taken from the seller's payout
  code        String // the buyer shows it at pickup; the seller enters it
  note        String    @default("")
  status      String    @default("PENDING") // PENDING | DONE | CANCELLED
  cancelledBy String? // buyer | seller | expired
  createdAt   DateTime  @default(now())
  doneAt      DateTime?
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  buyer       User      @relation("shopBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([buyerId, status])
  @@index([status, createdAt])
}

// Street Empire (the idle tycoon). The economy is settled from this snapshot + tickAt
// on every request (lib/idle.ts), so nothing runs in the background.
model Empire {
  userId      String    @id
  cash        Float     @default(5)
  run         Float     @default(0) // earned since the last fame reset
  total       Float     @default(0) // earned ever
  fame        Int       @default(0)
  biz         Json // { [business]: { n, mgr?, at? } }
  upg         String[]  @default([])
  boostUntil  DateTime  @default(now())
  tickAt      DateTime  @default(now())
  stepsSpent  Int       @default(0) // on Step Rush
  rushDay     String? // YYYY-MM-DD of the last rush (player's own day)
  rushes      Int       @default(0) // rushes that day
  rankClaimed Int       @default(0)
  dividendAt  DateTime?
  prestiges   Int       @default(0)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Steps per player per day (their own timezone). The phone's motion sensor counts
// while the game is open; GPS distance on foot fills in when it can't.
model StepDay {
  id       String    @id @default(cuid())
  userId   String
  day      String // YYYY-MM-DD
  motion   Int       @default(0)
  gps      Int       @default(0)
  motionAt DateTime? // last sensor report (GPS estimates pause while the sensor counts)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

// ---------------------------------------------------------------- Real places
// OpenStreetMap data for one ~450 m world cell (lib/geo CELL_DEG): buildings, roads,
// parks and water for the 3D drive, and named shops/restaurants/cafés for real-place
// missions. Fetched once from Overpass and kept (refreshed after a month); `data` is
// the compact CityTile from lib/city.ts.
model CityTile {
  key       String    @id // "<cx>_<cy>"
  data      Json? // geometry for the 3D city (only /api/city reads it)
  pois      Json? // Place[]: what missions and the map need, without the geometry
  fetchedAt DateTime?
  failedAt  DateTime? // last failed fetch (retried after a back-off)
  fails     Int       @default(0)
  createdAt DateTime  @default(now())
}

// A whole city's street detail, built in one go by scripts/city-pack.ts (lib/cityPack.ts):
// every mapped tree, lamp, traffic light, crossing, bench and sports pitch, cut into the
// same cells as CityTile. The 3D city lays it over the street-map tiles.
model CityPack {
  slug    String    @id // "tehran"
  name    String
  south   Float
  west    Float
  north   Float
  east    Float
  cells   Int       @default(0)
  objects Int       @default(0)
  pitches Int       @default(0)
  builtAt DateTime?
  status  String    @default("new") // new | building | ready | failed
  note    String?
}

model CityDetail {
  key       String   @id // "<cx>_<cy>"
  city      String
  data      Json // CityDetail (lib/city.ts): { o, f }
  updatedAt DateTime @updatedAt

  @@index([city])
}

// Live traffic (server/traffic.ts): the average speed on ~50 m of road in one direction,
// from players' real GPS while they move and from Neshan's live routing. Cells heard from
// by fewer than two players are never shown (nobody's trip can be traced).
model TrafficCell {
  key       String   @id // lib/traffic.ts trafficKey
  lat       Float
  lng       Float
  dir       Int // heading, 0–7 (45° steps from north, clockwise)
  kmh       Float
  samples   Int      @default(0)
  users     Int      @default(0)
  lastUser  String?
  src       String // "gps" | "neshan"
  updatedAt DateTime @updatedAt

  @@index([lat, lng])
  @@index([updatedAt])
}

// ---------------------------------------------------------------- Businesses
// A real store, restaurant or café on the map, run by its owner. Businesses pay for a
// plan (lib/business.ts) and post campaigns: missions players complete at the store
// (check in on the spot, optionally redeem a coupon at the till). Every visit and
// redemption is counted so the owner sees what the game brought in.
model Business {
  id        String        @id @default(cuid())
  ownerId   String
  name      String
  category  String // lib/places PlaceCat
  emoji     String        @default("🏪")
  about     String        @default("")
  address   String        @default("")
  phone     String        @default("")
  website   String        @default("")
  lat       Float
  lng       Float
  osmId     String? // the OpenStreetMap place it claims ("n123" / "w456")
  plan      String        @default("free") // free | starter | pro | chain
  planUntil DateTime? // paid plans run until then, then fall back to free
  trialUsed Boolean       @default(false)
  verified  Boolean       @default(false) // checked by an admin
  views     Int           @default(0) // times its card was opened in the game
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaigns BizCampaign[]
  landmarks Landmark[]

  @@index([lat, lng])
  @@index([ownerId])
  @@index([osmId])
}

model BizCampaign {
  id          String     @id @default(cuid())
  businessId  String
  title       String
  description String     @default("")
  kind        String     @default("visit") // visit (check in) | coupon (check in + redeem at the till)
  offer       String     @default("") // what the coupon gets you, in the owner's words
  rewardCoins Int        @default(40)
  rewardXp    Int        @default(60)
  bonusCoins  Int        @default(60) // extra when the coupon is redeemed in the store
  maxVisits   Int        @default(100)
  visits      Int        @default(0)
  redeemed    Int        @default(0)
  views       Int        @default(0)
  activeFrom  DateTime   @default(now())
  activeTo    DateTime
  paused      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visitRows   BizVisit[]

  @@index([businessId])
  @@index([activeTo])
}

// One per player per campaign: the check-in, and the coupon code shown at the till.
model BizVisit {
  id         String      @id @default(cuid())
  campaignId String
  userId     String
  code       String
  redeemedAt DateTime?
  createdAt  DateTime    @default(now())
  campaign   BizCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@unique([campaignId, code])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- Social network
// Posts in the feed: what players write (optionally with a photo and a check-in at a
// real place), plus moments the game posts for them (a delivery done, a store visited).
model Post {
  id        String        @id @default(cuid())
  authorId  String
  kind      String        @default("post") // post | checkin | mission | business
  body      String        @default("")
  placeName String?
  placeCat  String?
  lat       Float?
  lng       Float?
  photo     Bytes?
  photoType String?
  likes     Int           @default(0)
  comments  Int           @default(0)
  reports   Int           @default(0)
  hidden    Boolean       @default(false)
  createdAt DateTime      @default(now())
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likeRows  PostLike[]
  replies   PostComment[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([lat, lng])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostReport {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
}

// ---------------------------------------------------------------- 3D city: who's driving, and party games
// Where each player's vehicle is in the 3D city, streamed a few times a second while
// they drive (server/drive.ts). Separate from User.lastLat/lastLng: that's the game
// position (anti-cheat, rewards); this is what other drivers see, with heading,
// altitude and the vehicle. Rows go stale on their own — readers only look at fresh ones.
model DriveState {
  userId    String   @id
  name      String   @default("")
  avatar    String   @default("🙂")
  level     Int      @default(1)
  lat       Float
  lng       Float
  alt       Float    @default(0)
  yaw       Float    @default(0)
  speed     Float    @default(0)
  vehicle   String   @default("car")
  color     String   @default("#d7263d")
  virtual   Boolean  @default(true) // Driving from home / test mode (a virtual position), not following real GPS.
  startLat  Float // Where this drive started: strangers only see you once you've driven away from it.
  startLng  Float
  partyId   String?
  // Street Arena without the realtime server (server/arena.ts): on foot and fighting over HTTP.
  flags     Int       @default(0) // lib/arena/protocol F_* flags; F_FOOT set = walking, not driving
  pitch     Float     @default(0)
  weapon    Int       @default(0)
  hp        Int       @default(100)
  deadUntil DateTime?
  passive   Boolean   @default(true)
  fightAt   DateTime? // last shot fired or taken: going passive waits a little
  shotAt    DateTime? // last hit reported (fire-rate check)
  events    Json? // recent hits and kills on this player (last few seconds), read by their next report
  updatedAt DateTime  @updatedAt

  @@index([updatedAt, lat, lng])
  @@index([partyId])
}

// A group of friends hanging out in the 3D city. The host picks a game; the server
// referees each round from the members' DriveState (state = lib/party PartyState).
model DriveParty {
  id        String             @id @default(cuid())
  code      String             @unique
  hostId    String
  game      String             @default("race") // race | tag | coins
  status    String             @default("LOBBY") // LOBBY | LIVE | ENDED
  state     Json?
  version   Int                @default(0) // Optimistic lock: every state write bumps it, so concurrent position updates never overwrite each other.
  invited   String[]           @default([])
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  members   DrivePartyMember[]

  @@index([status, updatedAt])
}

model DrivePartyMember {
  id         String     @id @default(cuid())
  partyId    String
  userId     String
  name       String
  avatar     String
  score      Int        @default(0)
  place      Int?
  reward     String?
  rewardedAt DateTime?
  joinedAt   DateTime   @default(now())
  party      DriveParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, userId])
  @@index([userId, rewardedAt])
}

/// A store's own 3D building in the drive city (made in Blender, uploaded by an admin):
/// it stands at lat/lng in place of the map's building there. The model's origin is the
/// pin, +X east, −Z north, 1 unit = 1 m — the same frame as the footprint the admin
/// panel exports for Blender, so a model built on that footprint needs no adjusting.
model Landmark {
  id         String    @id @default(cuid())
  name       String
  businessId String?
  lat        Float
  lng        Float
  yaw        Float     @default(0) // degrees, clockwise seen from above
  scale      Float     @default(1)
  lift       Float     @default(0) // metres up (or down) from the street
  active     Boolean   @default(true)
  /// Only shown while the linked store's plan is paid.
  paidOnly   Boolean   @default(true)
  /// The model's outline at street level, in model metres [x0, z0, x1, z1, …] (convex
  /// hull, from the admin's browser): what cars hit and which map building it replaces.
  hull       Json      @default("[]")
  height     Float     @default(8)
  model      Bytes?
  modelHash  String    @default("")
  modelSize  Int       @default(0)
  /// Triangles, materials, textures… measured when it was uploaded.
  stats      Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([lat, lng])
}

// One player's line in a finished Street Arena match (realtime server → /api/rt/result).
// Unique per match and player, so a resent result can't pay twice; rewardedAt drives the
// daily cap on paid matches.
model ArenaResult {
  id         String    @id @default(cuid())
  matchId    String
  userId     String
  mode       String
  kills      Int       @default(0)
  botKills   Int       @default(0)
  deaths     Int       @default(0)
  score      Int       @default(0)
  place      Int       @default(0)
  won        Boolean   @default(false)
  xp         Int       @default(0)
  coins      Int       @default(0)
  rewardedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([matchId, userId])
  @@index([userId, rewardedAt])
}
