node_modules
.next
.env
prisma/*.db*
next-env.d.ts
*.tsbuildinfo
/.next-test
.vercel
.env*.local
/.next-e2e
/test-results
/playwright-report
/.next-qa
/.next-ui
.cache/

# Production settings for scripts run from this machine (npm run city:pack:prod) — never commit
.env.prod

# graphify output is a local, regenerable cache (run `graphify update .`) — never commit
graphify-out/

# Source 3D models (big, from Sketchfab): npm run assets:cars builds public/models/cars from them
/assets/models/*.glb
# npm run assets:get puts sources in assets/models/<kind>/ (credits: assets/credits.json, in git)
/assets/models/**/*.glb

# Blender build helpers (assets/blender/*.py) leave Python bytecode behind
__pycache__/

# Sound recordings you license (e.g. soundsnap.ir): npm run assets:sounds converts them to public/sounds
/assets/sounds/
# npm run assets:voices keeps its Piper voice models here (60 MB each)
/assets/voices/
