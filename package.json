{
  "name": "streetquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-sync.mjs && next build",
    "start": "next start",
    "rt": "tsx --env-file-if-exists=.env realtime/server.ts",
    "rt:dev": "tsx watch --env-file-if-exists=.env realtime/server.ts",
    "rt:smoke": "tsx --env-file-if-exists=.env realtime/smoke.ts",
    "rt:sim": "tsx realtime/sim.ts",
    "postinstall": "prisma generate",
    "vercel-build": "npm run build",
    "cf:build": "node scripts/cf-build.mjs",
    "cf:preview": "node scripts/cf-build.mjs preview",
    "cf:deploy": "node scripts/cf-build.mjs deploy",
    "cf:upload": "node scripts/cf-build.mjs upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "city:pack": "tsx scripts/city-pack.ts",
    "city:pack:prod": "tsx scripts/city-pack.ts --env .env.prod",
    "assets:arena": "/Applications/Blender.app/Contents/MacOS/Blender -b -P assets/blender/arena.py",
    "assets:cars": "tsx scripts/cars.ts",
    "assets:props": "tsx scripts/props.ts",
    "assets:catalog": "tsx scripts/object-catalog.ts",
    "relay:deploy": "bash scripts/relay-deploy.sh",
    "assets:find": "tsx scripts/sketchfab.ts find",
    "assets:get": "tsx --env-file-if-exists=.env scripts/sketchfab.ts get",
    "typecheck": "tsc --noEmit",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "test": "npm run -s test:unit && npm run -s typecheck && npm run -s i18n:check",
    "test:unit": "tsx --test tests/*.test.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:ui": "playwright test --project=mobile",
    "assets:people": "tsx scripts/people.ts",
    "product3d": "tsx --env-file-if-exists=.env scripts/product3d/worker.ts",
    "product3d:setup": "scripts/product3d/setup.sh",
    "assets:sounds": "tsx scripts/sounds.ts",
    "assets:voices": "tsx scripts/voices.ts",
    "transit:build": "tsx scripts/transit-osm.ts",
    "transit:times": "tsx scripts/transit-gtfs.ts",
    "test:lag": "tsx scripts/lag-test.ts",
    "load:server": "NEXT_DIST_DIR=.next-load next build && NEXT_DIST_DIR=.next-load next start -p 3300",
    "load:seed": "tsx --env-file-if-exists=.env scripts/load/seed.ts",
    "load:clean": "tsx --env-file-if-exists=.env scripts/load/seed.ts --clean",
    "load:test": "k6 run --quiet --log-output=none scripts/load/scenarios.js",
    "rt:deploy": "bash scripts/rt-deploy.sh",
    "front:deploy": "bash scripts/front-deploy.sh"
  },
  "dependencies": {
    "@huggingface/inference": "4.13.32",
    "@mapbox/vector-tile": "^3.0.0",
    "@opennextjs/cloudflare": "^1.20.18",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.10.0",
    "leaflet": "1.9",
    "next": "^15.5.29",
    "pbf": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "three": "^0.180.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "meshoptimizer": "^1.3.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true,
    "prisma@6.19.3": true
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "deepmerge-ts": "^8.0.0"
  }
}
